{
	"worktrees": {
		"**": {
			"worktreeRoot": "{{mainWorktree}}.worktrees",
			"onCreate": [
				"$HOME/.pi/agent/bin/pi-worktree-on-create.sh '{{mainWorktree}}' '{{path}}' '{{name}}' '{{branch}}'"
			],
			"onSwitch": [
				"$HOME/.pi/agent/bin/pi-worktree-on-switch.sh '{{mainWorktree}}' '{{path}}' '{{name}}' '{{branch}}'"
			]
		}
	},
	"matchingStrategy": "fail-on-tie",
	"onCreateDisplayOutputMaxLines": 20
}
